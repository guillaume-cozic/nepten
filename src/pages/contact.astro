---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base
  title="Contact"
  description="Contactez NeptEN par écrit ou par téléphone au 06 13 55 40 55 pour échanger sur votre projet en mécanique des fluides ou acoustique sous-marine."
  current="contact"
>
  <PageHero kicker="Contact" title="Vous avez un projet ? Échangeons !" />

  <section class="bg-white">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      <!-- Formulaire -->
      <div>
        <h2 class="text-2xl font-extrabold">Par écrit</h2>
        <form class="mt-8 space-y-6" method="post" action="#">
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="nom" class="block text-sm font-bold uppercase tracking-wide">Nom *</label>
              <input id="nom" name="nom" type="text" required class="mt-2 w-full rounded-xl border border-deep/20 bg-white px-4 py-3 font-medium shadow-sm outline-none transition focus:border-wave focus:ring-2 focus:ring-wave/30" />
            </div>
            <div>
              <label for="email" class="block text-sm font-bold uppercase tracking-wide">Email *</label>
              <input id="email" name="email" type="email" required class="mt-2 w-full rounded-xl border border-deep/20 bg-white px-4 py-3 font-medium shadow-sm outline-none transition focus:border-wave focus:ring-2 focus:ring-wave/30" />
            </div>
          </div>
          <div>
            <label for="entreprise" class="block text-sm font-bold uppercase tracking-wide">Nom de l'entreprise *</label>
            <input id="entreprise" name="entreprise" type="text" required class="mt-2 w-full rounded-xl border border-deep/20 bg-white px-4 py-3 font-medium shadow-sm outline-none transition focus:border-wave focus:ring-2 focus:ring-wave/30" />
          </div>
          <div>
            <label for="sujet" class="block text-sm font-bold uppercase tracking-wide">Sujet *</label>
            <input id="sujet" name="sujet" type="text" required class="mt-2 w-full rounded-xl border border-deep/20 bg-white px-4 py-3 font-medium shadow-sm outline-none transition focus:border-wave focus:ring-2 focus:ring-wave/30" />
          </div>
          <div>
            <label for="message" class="block text-sm font-bold uppercase tracking-wide">Message *</label>
            <textarea id="message" name="message" rows="6" required class="mt-2 w-full rounded-xl border border-deep/20 bg-white px-4 py-3 font-medium shadow-sm outline-none transition focus:border-wave focus:ring-2 focus:ring-wave/30"></textarea>
          </div>
          <button type="submit" class="rounded-full bg-deep px-8 py-4 font-bold text-white transition-colors hover:bg-ocean">
            Envoyer la demande
          </button>
        </form>
      </div>

      <!-- Coordonnées -->
      <aside class="space-y-6">
        <div class="rounded-3xl bg-linear-to-br from-deep to-ocean p-8 text-white">
          <h2 class="text-2xl font-extrabold">Par téléphone</h2>
          <a href="tel:+33613554055" class="mt-4 inline-block rounded-full bg-wave px-6 py-3 text-xl font-extrabold text-deep transition-colors hover:bg-sand">
            06 13 55 40 55
          </a>
        </div>
        <div class="rounded-3xl bg-foam p-8">
          <h2 class="text-xl font-extrabold">Où nous trouver</h2>
          <p class="mt-3 leading-relaxed text-navy">
            Lanvéoc Poulmic, au fond de la rade de Brest, devant l'École Navale.
            Le site est accessible toute l'année.
          </p>
        </div>
        <div class="rounded-3xl border border-deep/15 bg-white p-8 shadow-sm">
          <h2 class="text-xl font-extrabold">Nos infrastructures</h2>
          <ul class="mt-4 space-y-2 text-sm font-semibold">
            <li><a href="/tunnel-hydrodynamique" class="text-ocean hover:text-wave">→ Tunnel hydrodynamique</a></li>
            <li><a href="/plan-deau-instrumente-en-detection-acoustique" class="text-ocean hover:text-wave">→ Plan d'eau instrumenté</a></li>
            <li><a href="/banc-dessai-drone" class="text-ocean hover:text-wave">→ Hexapode et Mur de vent</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>
