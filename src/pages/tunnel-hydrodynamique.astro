---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const capacites = [
  'Analyse de performances de profils portants',
  'Analyse des phénomènes vibratoires (fréquences, amplitude, mode propre)',
  'Analyse des champs de vitesse par vélocimétrie par image de particules (PIV)',
  "Injection de bulles d'air",
  'Observation de la cavitation',
];

const specs = [
  { label: "Veine d'essai", value: '1000 mm × 192 × 192 mm' },
  { label: "Vitesse d'écoulement", value: '0 à 15 m/s (pas de 0,1 m/s)' },
  { label: 'Pression', value: '0,1 à 3 bars' },
  { label: 'Ouvertures', value: '4 × 760 × 192 mm' },
];

const mesures = [
  { title: 'Portance, traînée, moments', moyen: 'Balance' },
  { title: 'Déformée de la structure', moyen: 'Vibromètre laser' },
  { title: 'Champs de vitesse', moyen: 'PIV' },
  { title: 'Acoustique', moyen: 'Microphone' },
  { title: 'Bulles et cavitation', moyen: 'Caméra rapide' },
  { title: 'Profil de vitesse en sillage', moyen: 'LDV' },
];
---

<Base
  title="Tunnel hydrodynamique"
  description="Installation de pointe pour l'analyse des écoulements laminaires et turbulents et la validation de modèles en mécanique des fluides : PIV, cavitation, balance, LDV."
  current="tunnel"
>
  <PageHero
    kicker="Infrastructure expérimentale"
    title="Tunnel hydrodynamique"
    intro="Notre installation de pointe permet l'analyse précise des écoulements laminaires et turbulents et la validation de modèles scientifiques complexes en mécanique des fluides."
  />

  <!-- Capacités analytiques -->
  <section class="bg-white">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 md:grid-cols-2">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-ocean">Ce que l'installation permet</p>
        <h2 class="mt-2 text-3xl font-extrabold">Capacités analytiques</h2>
        <ul class="mt-8 space-y-4">
          {capacites.map((c) => (
            <li class="flex items-start gap-3">
              <span class="mt-1.5 block h-3 w-3 shrink-0 rounded-full bg-wave" aria-hidden="true"></span>
              <span class="font-semibold">{c}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="space-y-6">
        <div class="overflow-hidden rounded-3xl shadow-2xl shadow-deep/30">
          <img
            src="/images/tunnel-labo.jpg"
            alt="Le tunnel hydrodynamique dans le laboratoire de l'École Navale"
            class="block w-full object-cover"
          />
        </div>
        <div class="rounded-3xl bg-foam p-6">
          <img
            src="/images/tunnel-schema.png"
            alt="Schéma technique du tunnel hydrodynamique"
            class="block w-full"
            loading="lazy"
          />
          <p class="mt-3 text-center text-sm font-bold text-navy">Veine d'essai — écoulement contrôlé de 0 à 15 m/s</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Caractéristiques techniques -->
  <section class="bg-linear-to-br from-deep via-navy to-ocean text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <p class="text-xs font-bold uppercase tracking-widest text-wave">Fiche technique</p>
      <h2 class="mt-2 text-3xl font-extrabold">Caractéristiques techniques</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {specs.map((s) => (
          <div class="rounded-2xl bg-navy p-7">
            <p class="text-xs font-bold uppercase tracking-widest text-wave">{s.label}</p>
            <p class="mt-3 text-xl font-extrabold">{s.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mesures -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <p class="text-xs font-bold uppercase tracking-widest text-ocean">Instrumentation</p>
      <h2 class="mt-2 text-3xl font-extrabold">Possibilités de mesures</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {mesures.map((m) => (
          <div class="rounded-2xl border border-deep/15 bg-white p-7 shadow-sm">
            <h3 class="text-lg font-extrabold">{m.title}</h3>
            <p class="mt-2 inline-block rounded-full bg-foam px-4 py-1 text-sm font-bold text-ocean">{m.moyen}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Galerie d'essais -->
  <section class="bg-foam">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <p class="text-xs font-bold uppercase tracking-widest text-ocean">En images</p>
      <h2 class="mt-2 text-3xl font-extrabold">Essais dans la veine</h2>
      <div class="mt-10 overflow-hidden rounded-3xl shadow-2xl shadow-deep/30">
        <iframe
          class="aspect-video w-full"
          src="https://www.youtube-nocookie.com/embed/i-fB9wpUYHo?rel=0"
          title="Le tunnel hydrodynamique en fonctionnement"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <figure class="overflow-hidden rounded-3xl bg-white shadow-sm">
          <img src="/images/tunnel-veine.jpg" alt="La veine d'essai instrumentée avec le vibromètre laser" class="block aspect-[3/2] w-full object-cover" loading="lazy" />
          <figcaption class="p-5 text-sm font-semibold text-navy">La veine d'essai instrumentée (vibromètre laser)</figcaption>
        </figure>
        <figure class="overflow-hidden rounded-3xl bg-white shadow-sm">
          <img src="/images/cavitation-profil.png" alt="Cavitation observée sur un profil portant" class="block aspect-[3/2] w-full object-cover" loading="lazy" />
          <figcaption class="p-5 text-sm font-semibold text-navy">Observation de la cavitation sur un profil</figcaption>
        </figure>
        <figure class="overflow-hidden rounded-3xl bg-white shadow-sm">
          <img src="/images/profil-laser.png" alt="Profil portant éclairé par nappe laser pour mesure PIV" class="block aspect-[3/2] w-full object-cover" loading="lazy" />
          <figcaption class="p-5 text-sm font-semibold text-navy">Mesure PIV par nappe laser sur profil</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="bg-white px-4">
    <div class="mx-auto my-20 flex max-w-7xl flex-wrap items-center justify-between gap-6 rounded-[2.5rem] bg-linear-to-r from-ocean to-deep px-8 py-12 sm:px-12">
      <h2 class="text-2xl font-extrabold text-white md:text-3xl">Besoin d'une campagne d'essais ?</h2>
      <a href="/contact" class="rounded-full bg-wave px-8 py-3.5 font-bold text-deep transition-colors hover:bg-sand">
        Parlons-en
      </a>
    </div>
  </section>
</Base>
