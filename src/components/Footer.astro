---
const base = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="bg-deep text-white">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-3">
    <div>
      <img src={base + "/images/logo-blanc.png"} alt="NeptEN — Bureau d'études navales" class="h-36 w-auto" />
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-foam/80">
        Bureau d'études en mécanique des fluides et acoustique sous-marine,
        adossé à l'institut de recherche de l'École Navale.
      </p>
    </div>
    <nav aria-label="Plan du site">
      <p class="text-xs font-bold uppercase tracking-widest text-wave">Navigation</p>
      <ul class="mt-4 space-y-2 text-sm font-semibold">
        <li><a href={base + "/expertise"} class="hover:text-wave">Expertise</a></li>
        <li><a href={base + "/tunnel-hydrodynamique"} class="hover:text-wave">Tunnel hydrodynamique</a></li>
        <li><a href={base + "/plan-deau-instrumente-en-detection-acoustique"} class="hover:text-wave">Plan d'eau instrumenté</a></li>
        <li><a href={base + "/banc-dessai-drone"} class="hover:text-wave">Hexapode et Mur de vent</a></li>
        <li><a href={base + "/projets"} class="hover:text-wave">Projets</a></li>
      </ul>
    </nav>
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-wave">Contact</p>
      <p class="mt-4 text-sm font-semibold">Lanvéoc Poulmic — Rade de Brest</p>
      <p class="mt-2 text-sm"><a href="tel:+33613554055" class="font-semibold hover:text-wave">06 13 55 40 55</a></p>
      <a href={base + "/contact"} class="mt-5 inline-block rounded-full bg-wave px-6 py-2.5 text-sm font-bold text-deep transition-colors hover:bg-sand">
        Échangeons sur votre projet
      </a>
    </div>
  </div>
  <div class="border-t-2 border-navy">
    <p class="mx-auto max-w-7xl px-4 py-5 text-xs text-foam/60 sm:px-6">© {year} NeptEN — Tous droits réservés.</p>
  </div>
</footer>
