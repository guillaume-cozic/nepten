---
const { kicker, title, intro } = Astro.props;
---

<section class="bg-linear-to-br from-deep via-navy to-ocean text-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-24">
    {kicker && <p class="mb-4 inline-block rounded-full bg-wave px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-deep">{kicker}</p>}
    <h1 class="max-w-3xl text-4xl font-extrabold leading-tight md:text-5xl">{title}</h1>
    {intro && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-foam/85">{intro}</p>}
  </div>
</section>
